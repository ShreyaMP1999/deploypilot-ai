# Generate JWT_SECRET with: python -c 'import secrets; print(secrets.token_hex(32))'
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
DEMO_PASSWORD=change-this-demo-password
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=sqlite:///./deploypilot.db
CORS_ORIGINS=http://localhost:3000
AGENT_MODE=offline
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Set your model's current USD rates to enable cost estimates; zero = unconfigured.
INPUT_COST_PER_MILLION=0
OUTPUT_COST_PER_MILLION=0
